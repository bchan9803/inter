generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  firebaseUID String   @id
  username    String   @unique
  // dateJoined  String?
  roomsJoined String[]
}

model Room {
  id           String   @id @default(cuid())
  roomName     String
  roomPassword String
  users        String[]

  @@unique([roomName, roomPassword])
}
